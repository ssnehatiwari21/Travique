<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-5">
  <div class="col-10 col-md-4 col-lg-3">
    <div class="card edit-profile-card">

      <div class="auth-header">
        <div class="user-avatar mx-auto mb-3" style="width:60px;height:60px;font-size:1.5rem;">
          <%= user.username.charAt(0).toUpperCase() %>
        </div>
        <h3 class="auth-title">Edit Profile</h3>
        <p class="auth-sub">Update your account details</p>
      </div>

      <hr>

      <form action="/profile?_method=PUT" method="POST" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input type="text" class="form-control <%= formErrors.username ? 'is-invalid' : '' %>" id="username" name="user[username]" value="<%= formValues.username || user.username %>" required>
          <% if (formErrors.username) { %>
            <div class="invalid-feedback d-block"><%= formErrors.username %></div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control <%= formErrors.email ? 'is-invalid' : '' %>" id="email" name="user[email]" value="<%= formValues.email || user.email %>" required>
          <% if (formErrors.email) { %>
            <div class="invalid-feedback d-block"><%= formErrors.email %></div>
          <% } %>
        </div>

        <button type="submit" class="btn add-btn w-100">Save Changes</button>
        <a href="/profile" class="btn outline-btn w-100 mt-2">Cancel</a>

      </form>
    </div>
  </div>
</div>