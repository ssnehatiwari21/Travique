<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center">
  <div class="col-md-5 col-sm-8">
    <div class="auth-card">

      <div class="auth-header">
        <i class="fa-solid fa-map-location-dot auth-icon"></i>
        <h3 class="auth-title">Join Travique</h3>
        <p class="auth-sub">Create your account and start exploring</p>
      </div>

      <form method="POST" action="/signup" novalidate class="needs-validation">

        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input
            id="username"
            name="username"
            placeholder="enter username"
            type="text"
            class="form-control <%= formErrors.username ? 'is-invalid' : '' %>"
            value="<%= formValues.username || '' %>"
            required
          >
          <% if (formErrors.username) { %>
            <div class="invalid-feedback d-block"><%= formErrors.username %></div>
          <% } else { %>
            <div class="invalid-feedback">Please enter a username.</div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input
            id="email"
            name="email"
            placeholder="enter email"
            type="email"
            class="form-control <%= formErrors.email ? 'is-invalid' : '' %>"
            value="<%= formValues.email || '' %>"
            required
          >
          <% if (formErrors.email) { %>
            <div class="invalid-feedback d-block"><%= formErrors.email %></div>
          <% } else { %>
            <div class="invalid-feedback">Please enter a valid email.</div>
          <% } %>
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input
            id="password"
            name="password"
            placeholder="enter password"
            type="password"
            class="form-control"
            required
          >
          <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button class="btn add-btn w-100 mt-2">Create Account</button>

      </form>

      <p class="auth-footer">Already have an account? <a href="/login">Log in</a></p>

    </div>
  </div>
</div>