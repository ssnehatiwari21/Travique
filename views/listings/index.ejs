<% layout("/layouts/boilerplate") %>

<div class="filter-row">
  <div class="filters">
    <% const filters = [
      { key: "all",      icon: "fa-solid fa-grip",           label: "All" },
      { key: "beach",    icon: "fa-solid fa-umbrella-beach", label: "Beachfront" },
      { key: "mountain", icon: "fa-solid fa-mountain",       label: "Mountains" },
      { key: "island",   icon: "fa-solid fa-water",          label: "Islands" },
      { key: "safari",   icon: "fa-solid fa-paw",            label: "Safari" },
      { key: "ski",      icon: "fa-solid fa-person-skiing",  label: "Ski" },
      { key: "historic", icon: "fa-solid fa-landmark",       label: "Historic" },
      { key: "desert",   icon: "fa-solid fa-sun",            label: "Desert" },
    ] %>
    <% for (let f of filters) { %>
      <a href="/listings?category=<%= f.key %>&tax=<%= showTax %>"
         class="filter <%= activeCategory === f.key ? 'active' : '' %>">
        <i class="<%= f.icon %>"></i>
        <p><%= f.label %></p>
      </a>
    <% } %>
  </div>

  <div class="tax-toggle-wrap" onclick="document.getElementById('taxToggle').click()">
  <i class="fa-solid fa-receipt" style="color: #C8A96E; font-size: 0.95rem;"></i>
  <div class="form-check form-switch">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="taxToggle"
        <%= showTax ? 'checked' : '' %>
        onclick="event.stopPropagation()"
      >
      <label class="form-check-label" for="taxToggle">Include taxes</label>
    </div>
  </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-3">
  <% if (allListings.length === 0) { %>
    <div class="col-12">
      <div class="alert alert-light text-center mt-4">
        No listings found for this category.
      </div>
    </div>
  <% } %>
  <% for (let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card">
          <img src="<%= listing.image.url %>"
               class="card-img-top"
               alt="<%= listing.title %>"
               style="height: 22rem;">
          <div class="card-img-overlay"></div>
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
              <span class="listing-location">
                <i class="fa-solid fa-location-dot fa-xs"></i>
                <%= listing.location %>, <%= listing.country %>
              </span><br>
              <span class="listing-price">
                <% if (showTax) { %>
                  &#8377;<%= Math.round((listing.price || 0) * 1.18).toLocaleString("en-IN") %>
                  <span class="per-night">/ guest <span class="tax-label">incl. taxes</span></span>
                <% } else { %>
                  &#8377;<%= (listing.price || 0).toLocaleString("en-IN") %>
                  <span class="per-night">/ guest <i class="tax-info">&nbsp;+18% GST</i></span>
                <% } %>
              </span>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>

<script>
  document.getElementById('taxToggle').addEventListener('change', function () {
    const url = new URL(window.location.href);
    url.searchParams.set('tax', this.checked ? 'true' : 'false');
    window.location.href = url.toString();
  });
</script>