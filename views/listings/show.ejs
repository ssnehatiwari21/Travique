<% layout("/layouts/boilerplate") %>

<div class="show-page">

  <div class="show-hero">
    <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="show-hero-img">
  </div>

  <div class="show-body">

    <div class="show-main">

      <div class="show-title-row">
        <div>
          <h2 class="show-title"><%= listing.title %></h2>
          <p class="show-location">
            <i class="fa-solid fa-location-dot"></i>
            <%= listing.location %>, <%= listing.country %>
          </p>
        </div>
        <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
        <div class="show-owner-actions">
          <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
            <i class="fa-solid fa-pencil"></i> Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn delete-btn">
              <i class="fa-solid fa-trash"></i> Delete
            </button>
          </form>
        </div>
        <% } %>
      </div>

      <div class="show-owner-tag">
        <div class="user-avatar" style="width:32px;height:32px;font-size:0.85rem;flex-shrink:0;">
          <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : "?" %>
        </div>
        <span>Hosted by <strong><%= listing.owner ? listing.owner.username : "Unknown" %></strong></span>
      </div>

      <hr>

      <div class="show-description">
        <p><%= listing.description %></p>
      </div>

      <hr>

      <div class="show-map-section">
        <h5 class="show-section-title">
          <i class="fa-solid fa-map-location-dot"></i> Where you'll be
        </h5>
        <div id="map" class="show-map"></div>
      </div>

    </div>

    <div class="show-sidebar">

      <div class="show-price-card">
        <div class="show-price-main">
          <span class="show-price-amount">
            ₹<%= (listing.price || 0).toLocaleString("en-IN") %>
          </span>
          <span class="show-price-unit">/ night</span>
        </div>
        <p class="show-price-tax">+18% GST applicable</p>
        <a href="#review-form" class="btn add-btn w-100 mt-2">Reserve</a>
      </div>

      <% if(currentUser) { %>
      <div class="show-review-form" id="review-form">
        <h5 class="show-section-title">Leave a Review</h5>
        <div class="review-card">
          <div class="card-body">
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
              <div class="mb-3">
                <label class="form-label">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>
              <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" rows="3"
                  class="form-control" placeholder="Share your experience..." required></textarea>
                <div class="invalid-feedback">Please share your experience.</div>
              </div>
              <button type="submit" class="btn review-submit-btn w-100">Submit Review</button>
            </form>
          </div>
        </div>
      </div>
      <% } %>

    </div>

  </div>

  <div class="show-all-reviews">
    <hr>
    <h5 class="show-section-title mb-3">
      <i class="fa-solid fa-star"></i>
      <%= listing.reviews.length %> Review<%= listing.reviews.length !== 1 ? 's' : '' %>
    </h5>
    <% if(listing.reviews.length > 0) { %>
      <div class="reviews-grid">
        <% for(let review of listing.reviews) { %>
          <div class="card review-card">
            <div class="card-body">
              <div class="d-flex align-items-center gap-2 mb-2">
                <div class="user-avatar" style="width:30px;height:30px;font-size:0.8rem;flex-shrink:0;">
                  <%= review.author.username.charAt(0).toUpperCase() %>
                </div>
                <h6 class="card-title mb-0"><%= review.author.username %></h6>
              </div>
              <p class="starability-result" data-rating="<%= review.rating %>"></p>
              <p class="card-text mb-2"><%= review.comment %></p>
              <% if(currentUser && review.author && currentUser._id.toString() === review.author._id.toString()) { %>
              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button class="btn btn-sm delete-btn">
                  <i class="fa-solid fa-trash fa-xs"></i> Delete
                </button>
              </form>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="alert alert-light">No reviews yet. Be the first to review!</div>
    <% } %>
  </div>

</div>

<script>
window.addEventListener("load", () => {
  const latitude = <%- JSON.stringify(listing.latitude || 20) %>;
  const longitude = <%- JSON.stringify(listing.longitude || 0) %>;
  const map = L.map('map').setView([latitude, longitude], 13);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
  L.marker([latitude, longitude])
    .addTo(map)
    .bindPopup(`<b><%= listing.location %></b><br><%= listing.country %>`)
    .openPopup();
});
</script>